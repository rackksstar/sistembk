# Path relatif ke folder chatbot_service atau absolut
BOOK_PDF_PATH=Buku_Bimbingan_Konseling_Masdudi.pdf
KNOWLEDGE_DIR=./knowledge
BOOK_INDEX_DB=./book_index.sqlite3
MEMORY_DB=./chat_memory.sqlite3

CHATBOT_PROVIDER=local
CHATBOT_TOP_K=6
MIN_CONTENT_PAGE=8
MAX_HISTORY_TURNS=10
MAX_MESSAGE_CHARS=2000

# Port service (Laravel core biasanya 8000 — chatbot pakai 8001)
CHATBOT_PORT=8001

# Wajib di VPS/cloud. Samakan dengan CHATBOT_API_TOKEN di Laravel .env
CHATBOT_API_TOKEN=
